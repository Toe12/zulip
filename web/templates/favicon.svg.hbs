<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
    <style>
        @font-face {
        font-family: 'Source Sans 3';
        font-style: normal;
        font-weight: 700;
        src: url({{{favicon_font_url_html}}}) format('truetype');
        }
    </style>
    <circle cx="8" cy="8" r="8" fill="#fff" />
    <g transform="translate(8 8) scale(0.082) translate(-86 -78)">
        <line x1="52" y1="20" x2="52" y2="116" stroke="#111827" stroke-width="12" stroke-linecap="round" />
        <circle cx="88" cy="84" r="32" fill="none" stroke="#111827" stroke-width="12" />
        <circle cx="88" cy="84" r="8" fill="#6366F1" />
        <line x1="46" y1="136" x2="126" y2="136" stroke="#6366F1" stroke-width="8" stroke-linecap="round" />
    </g>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      fill="white" stroke="white" stroke-width="2" stroke-linejoin="round" opacity=".5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    {{#if have_pm}}
    <circle cx="14" cy="4" r="2" fill="#f00" />
    {{/if}}
</svg>
